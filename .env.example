# Kopieer naar .env (cp .env.example .env). npm start leest dit bestand automatisch.
# Alles is optioneel; zonder waarden gelden de standaarden uit de README.

# PORT=3000
# DATA_DIR=./data

# ffprobe/ffmpeg worden automatisch gezocht in PATH, /opt/homebrew/bin, /usr/local/bin en /usr/bin.
# Alleen invullen als ze ergens anders staan:
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
