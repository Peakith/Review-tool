# Domein dat naar de server wijst (A-record), bijv. review-test.jouwagency.nl
DOMAIN=review-test.jouwagency.nl

# Eenmalige code voor het eerste teamaccount (zelf kiezen, minstens 20 tekens)
SETUP_TOKEN=

# Gedeelde login voor de afgeschermde testomgeving (Caddy basic auth)
PREVIEW_USER=preview
# Tussen enkele aanhalingstekens zetten, anders worden de $-tekens in de hash vervangen
PREVIEW_PASSWORD_HASH=''

MAX_UPLOAD_GB=20
UPLOAD_EXPIRY_HOURS=24
